# PostgreSQL connection string. Keep real credentials in .env or Secret Manager.
# For Neon, use its pooled hostname and require TLS:
# postgresql+psycopg://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/shopify_ai

# Optional application settings
APP_NAME=Shopify Analytics API
DEPLOYMENT_ENVIRONMENT=development
API_DOCS_ENABLED=true
API_AUTH_ENABLED=false
SHOPIFY_API_KEY=replace-with-shopify-client-id
SHOPIFY_API_SECRET=replace-with-shopify-client-secret
TENANT_ASSERTION_SECRET=replace-with-at-least-32-random-characters
TENANT_ASSERTION_ISSUER=smj-shopify-frontend
TENANT_ASSERTION_AUDIENCE=smj-shopify-api
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300
LOW_STOCK_THRESHOLD=10
LOW_AOV_THRESHOLD=50.00
HIGH_DISCOUNT_RATE_THRESHOLD=0.20
REFUND_RATE_THRESHOLD=0.10
CANCELLATION_RATE_THRESHOLD=0.10
